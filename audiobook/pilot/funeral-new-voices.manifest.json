      "cached": true
    },
    {
      "id": "038",
      "speaker": "SHAWNA",
      "voice": "af_heart",
      "speed": 1.0,
      "text": "Eight minutes. Kitchen. Stay there until we get the case.",
      "start_seconds": 113.594,
      "speech_seconds": 3.4987,
      "pause_ms": 180,
      "cache_key": "7c5d0ca7989895e58c5de30eb6f4f30afa9b812944c33b037080e6117ad19bbb",
      "raw_peak": 0.35107526183128357,
      "rms": 0.056990468928212704,
      "render_seconds": 0.001,
      "cached": true
    },
    {
      "id": "039",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "Nigga, I could take it right now.",
      "start_seconds": 117.2726,
      "speech_seconds": 3.2,
      "pause_ms": 100,
      "cache_key": "13cdfb543a8f6650d8fd4ea8e1c8046cecc4d25f4514e5f226605e944bfcbf8e",
      "raw_peak": 0.30078125,
      "rms": 0.03836784459639194,
      "render_seconds": 0.001,
      "cached": true
    },
    {
      "id": "040",
      "speaker": "SHAWNA",
      "voice": "af_heart",
      "speed": 1.0,
      "text": "And Silas’s men could start shooting into everybody who paid to eat shrimp.",
      "start_seconds": 120.5726,
      "speech_seconds": 4.4253,
      "pause_ms": 160,
      "cache_key": "9de29533127c3944a577441fd08f5ff735dec3e157ec438a628312e2091b1a44",
