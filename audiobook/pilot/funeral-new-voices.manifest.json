      "render_seconds": 0.0,
      "cached": true
    },
    {
      "id": "047",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "Which thing?",
      "start_seconds": 180.0986,
      "speech_seconds": 0.96,
      "pause_ms": 150,
      "cache_key": "e366ce931873b1eb741f4b3ae15f572bbd389c310e910cedbf01954b2786009b",
      "raw_peak": 0.388671875,
      "rms": 0.050548129973255515,
      "render_seconds": 0.001,
      "cached": true
    },
    {
      "id": "048",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "She looked around my funeral.",
      "start_seconds": 181.2086,
      "speech_seconds": 1.76,
      "pause_ms": 100,
      "cache_key": "cb64723ccfc868dba0382f39878984ded4858f276efaf3ce0e08c330ceb80d22",
      "raw_peak": 0.17578125,
      "rms": 0.03558085966996535,
      "render_seconds": 0.001,
      "cached": true
    },
    {
      "id": "049",
      "speaker": "MERCEDES",
      "voice": "af_bella",
      "speed": 1.0,
      "text": "The thing where this becomes about you.",
      "start_seconds": 183.0686,
      "speech_seconds": 2.0126,
      "pause_ms": 180,
      "cache_key": "6a60520a6d39b0858423ccc4189fcee51852c6d52e623690b29b26479bf3f940",
      "raw_peak": 0.45785245299339294,
