    {
      "id": "037",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "I pulled her close. She put two fingers against my mouth.",
      "start_seconds": 109.174,
      "speech_seconds": 4.32,
      "pause_ms": 100,
      "cache_key": "ce3cfea24104a8256d46fb931c1cfef87f198a2f4a3bd6e388d9b162877e0e48",
