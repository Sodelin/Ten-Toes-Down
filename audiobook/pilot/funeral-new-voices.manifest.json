    },
    {
      "id": "042",
      "speaker": "SHAWNA",
      "voice": "af_heart",
      "speed": 1.0,
      "text": "Aiden.",
      "start_seconds": 127.018,
      "speech_seconds": 0.896,
      "pause_ms": 300,
      "cache_key": "3ca8c023298f07c1800712a6fe3a967d879a167b07c78772082f3a4ab5e05cde",
      "raw_peak": 0.3441128134727478,
      "rms": 0.0605882665255426,
      "render_seconds": 0.0,
      "cached": true
    },
    {
      "id": "043",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "I straightened up. Mercedes stood beside the stage in a red suit, thumb pressed into her palm. She’d been doing that all week. Silas Gold had stolen the original recordings of her first album. The nigga had locked the drive in a silver case and invited buyers to bid. She could sing every song again. She couldn’t rebuild the demolished studio, recall every musician to the same night, or make her voice crack exactly where it had in the last chorus. She had left that crack in. Said it sounded like her.",
      "start_seconds": 128.214,
      "speech_seconds": 25.84,
      "pause_ms": 450,
      "cache_key": "c990523834badf9203c1f773d6ac0896f5ffa8379d4327be59bbd69c0b5b79a9",
      "raw_peak": 0.427734375,
      "rms": 0.05915694858359188,
      "render_seconds": 0.007,
      "cached": true
    },
    {
      "id": "044",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "Silas lived behind bulletproof glass and sent other niggas out to be unpleasant. Tell him Aiden was dead, though, and suddenly the motherfucker wanted fresh air. Shawna had promised a private auction after the memorial. My watch, my cars, the collection. Silas would bring the recordings so they could settle everything together. Mercedes would inspect the case backstage. Porsche would switch it. I would stay in the fucking kitchen.",
      "start_seconds": 154.504,
      "speech_seconds": 20.08,
      "pause_ms": 420,
      "cache_key": "44c32f3b38e2ad6d227c798c6eee9bfd478b88643ea0d761527892f881b853f4",
      "raw_peak": 0.55859375,
      "rms": 0.0756909977888579,
      "render_seconds": 0.005,
      "cached": true
    },
    {
      "id": "045",
      "speaker": "AIDEN",
      "voice": "qwen-designed-aiden",
      "speed": 1.0,
      "text": "Mercedes caught me looking and came to fix my collar.",
      "start_seconds": 175.004,
      "speech_seconds": 3.2,
      "pause_ms": 120,
      "cache_key": "2fd643be3d227fc2510aaf3c455a26300dcfa9112a2baf28bf5168084d5e1969",
      "raw_peak": 0.53125,
      "rms": 0.07596954225308536,
      "render_seconds": 0.001,
      "cached": true
    },
    {
      "id": "046",
      "speaker": "MERCEDES",
      "voice": "af_bella",
      "speed": 1.0,
      "text": "Nigga, don’t do the thing.",
      "start_seconds": 178.324,
      "speech_seconds": 1.6147,
      "pause_ms": 160,
      "cache_key": "1288acb1afceae9fb29d2211beb734ff0b8128fd67547f355ceffc7c39a5283c",
      "raw_peak": 0.4314258396625519,
